--- a/arch/arm/boot/dts/imx28-pwsh1.dts
+++ b/arch/arm/boot/dts/imx28-pwsh1.dts
@@ -115,3 +115,40 @@
 		/* <0x0c KEY_PAGEDOWN>, */ /* Page Down */
 		<0x06 KEY_LEFTALT>;  /* Switch characters */
 };
+
+&sgtl5000 {
+	status = "disabled";
+};
+
+&buzzer_cold {
+	status = "disabled";
+};
+
+&pinctrl {
+	ymu818b_reset_pin: ymu818b-reset@0 {
+		reg = <0>;
+		fsl,pinmux-ids = <
+			MX28_PAD_GPMI_RESETN__GPIO_0_28
+		>;
+		fsl,drive-strength = <MXS_DRIVE_4mA>;
+		fsl,voltage = <MXS_VOLTAGE_HIGH>;
+		fsl,pull-up = <MXS_PULL_DISABLE>;
+	};
+};
+
+&i2c0 {
+	ymu818b: codec@3a {
+		compatible = "yamaha,ymu818b";
+		reg = <0x3a>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&ymu818b_reset_pin>;
+		#sound-dai-cells = <0>;
+		reset-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
+	};
+};
+
+&sound {
+	compatible = "sharp,mxs-audio-ymu818b";
+	model = "Brain-YMU818B";
+	audio-codec = <&ymu818b>;
+};
