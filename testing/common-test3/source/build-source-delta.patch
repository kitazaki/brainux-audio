+
+	ret = ymu818b_mc1n2_write_b(ymu818b, MC1N2_MCI_MIX_ADR,
+				    MC1N2_MCI_MIX_WINDOW,
+				    MC1N2_MCI_MASTER_OUTL,
+				    MC1N2_DIG_VOL_0DB_LATCH);
+	if (ret)
+		return ret;
+
+	ret = ymu818b_mc1n2_write_b(ymu818b, MC1N2_MCI_MIX_ADR,
+				    MC1N2_MCI_MIX_WINDOW,
+				    MC1N2_MCI_MASTER_OUTR,
+				    MC1N2_DIG_VOL_0DB);
+	if (ret)
+		return ret;
+
+	ret = ymu818b_mc1n2_write_b(ymu818b, MC1N2_MCI_MIX_ADR,
+				    MC1N2_MCI_MIX_WINDOW,
+				    MC1N2_MCI_DAC_ATTL,
+				    MC1N2_DIG_VOL_0DB_LATCH);
+	if (ret)
+		return ret;
+
+	ret = ymu818b_mc1n2_write_b(ymu818b, MC1N2_MCI_MIX_ADR,
+				    MC1N2_MCI_MIX_WINDOW,
+				    MC1N2_MCI_DAC_ATTR,
+				    MC1N2_DIG_VOL_0DB);
+	if (ret)
+		return ret;
+
+	ret = ymu818b_mc1n2_write_b(ymu818b, MC1N2_MCI_ANA_ADR,
+				    MC1N2_MCI_ANA_WINDOW,
+				    MC1N2_MCI_SPL_MIX,
+				    MC1N2_DAC_MIX);
+	if (ret)
+		return ret;
+
+	ret = ymu818b_mc1n2_write_b(ymu818b, MC1N2_MCI_ANA_ADR,
+				    MC1N2_MCI_ANA_WINDOW,
+				    MC1N2_MCI_SPL_MONO,
+				    MC1N2_DAC_MONO);
+	if (ret)
+		return ret;
+
+	ret = ymu818b_mc1n2_write_b(ymu818b, MC1N2_MCI_ANA_ADR,
+				    MC1N2_MCI_ANA_WINDOW,
+				    MC1N2_MCI_SPR_MIX,
+				    MC1N2_DAC_MIX_R);
+	if (ret)
+		return ret;
+
+	ret = ymu818b_mc1n2_write_b(ymu818b, MC1N2_MCI_ANA_ADR,
+				    MC1N2_MCI_ANA_WINDOW,
+				    MC1N2_MCI_SPR_MONO,
+				    MC1N2_DAC_MONO_R);
+	if (ret)
+		return ret;
+
+	ret = ymu818b_mc1n2_write_b(ymu818b, MC1N2_MCI_ANA_ADR,
+				    MC1N2_MCI_ANA_WINDOW,
